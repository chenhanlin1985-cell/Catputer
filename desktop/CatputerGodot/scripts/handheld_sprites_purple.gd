static var _cache: Dictionary = {}

static func get_frames(state: String) -> Array[Texture2D]:
	_ensure_cache()
	return _cache.get(state, [])

static func _ensure_cache() -> void:
	if not _cache.is_empty():
		return
	_cache["idle"] = _build_group(["purple_sprite_idle1", "purple_sprite_idle2", "purple_sprite_idle1", "purple_sprite_idle3"])
	_cache["happy"] = _build_group(["purple_sprite_happy1", "purple_sprite_happy2"])
	_cache["sleep"] = _build_group(["purple_sprite_sleep1"])
	_cache["talk"] = _build_group(["purple_sprite_talk1", "purple_sprite_talk2"])

static func _build_group(names: Array[String]) -> Array[Texture2D]:
	var frames: Array[Texture2D] = []
	for name in names:
		frames.append(_build_texture(name))
	return frames

static func _build_texture(name: String) -> Texture2D:
	var pixels: Array = RAW_SPRITES.get(name, [])
	var image := Image.create(WIDTH, HEIGHT, false, Image.FORMAT_RGBA8)
	for y in range(HEIGHT):
		for x in range(WIDTH):
			var token: String = pixels[y * WIDTH + x]
			image.set_pixel(x, y, PALETTE.get(token, Color(1, 0, 1, 1)))
	image.resize(WIDTH * SCALE, HEIGHT * SCALE, Image.INTERPOLATE_NEAREST)
	return ImageTexture.create_from_image(image)

