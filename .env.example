# Catputer environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then source before building:
#   source .env && pio run -t upload

# WiFi (required)
export WIFI_SSID="<your-wifi-ssid>"
export WIFI_PASS="<your-wifi-password>"

# AI backend (required for chat)
# Default firmware expects an OpenAI-compatible HTTPS endpoint.
export API_HOST="dashscope.aliyuncs.com"
export API_PORT="443"
export API_KEY="<your-api-key>"

# Voice input / TTS relay (optional)
# Groq API key is used by tools/stt_proxy.py, not by the firmware itself.
export GROQ_API_KEY="<your-groq-api-key>"
export STT_PROXY_HOST="<your-lan-host-ip>"
export STT_PROXY_PORT="8090"

# Weather (optional)
export DEFAULT_CITY="Shenzhen"

# Secondary WiFi (optional, e.g. phone hotspot)
export WIFI_SSID2=""
export WIFI_PASS2=""
export API_HOST2=""
